# ------------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is gitignored and must
# NEVER be committed. This is the only file that holds secrets.
# ------------------------------------------------------------------

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SOCKET_MODE=true # false = run HTTP server on PORT
PORT=3000

# --- Elastic ---
# API endpoint - all of Elastibot's requests go here. Must be the instance the API keys authenticate against
KIBANA_URL=https://kibana.internal:5601
# Browser endpoint used for the links posted in Slack. Set this when analysts
# reach Kibana through a proxy, so clicking a case link doesn't force a re-login.
# Leave unset to reuse KIBANA_URL
KIBANA_PUBLIC_URL=https://kibana.example.com
ELASTICSEARCH_URL=https://es.internal:9200
# Service account API key (encoded form) used by the watchers and for space lookups
ELASTIC_SERVICE_API_KEY=base64EncodedApiKey=
# Set to false for self-signed certs on an internal cluster
ELASTIC_TLS_REJECT_UNAUTHORIZED=true
ELASTIC_TIMEOUT_MS=15000
ALERTS_INDEX=.alerts-security.alerts-*
DEFAULT_CASE_OWNER=securitySolution

# --- Elastibot secrets ---
# 32+ chars. Used to encrypt analysts' stored API keys at rest
ELASTIBOT_SECRET_KEY=change-me-to-a-long-random-string

# --- Automatic API key provisioning (optional) ---
# Comma-separated Slack user IDs allowed to use /start's "create one for me"
# option, which has Elastibot call POST /_security/api_key itself instead of
# the analyst copy-pasting a key out of Kibana. Leave empty (the default) to
# disable the option for everyone.
#
# This is Slack-side gating only. Elasticsearch separately - and always -
# enforces that whatever admin credential someone pastes into that option
# actually holds manage_api_key / manage_own_api_key; a credential without it
# is simply rejected regardless of what this list says.
AUTO_PROVISION_SLACK_IDS=

# --- Watchers ---
WATCHERS_ENABLED=true
WATCH_POLL_MS=60000
DEFAULT_CHANNEL=C0123456789
WATCH_CASE_SPACES=default

# --- /stats ---
# Lookback used when /stats is called with no window
STATS_DEFAULT_WINDOW=7d
STATS_MAX_WINDOW_DAYS=90
# Timezone the hour-of-day / day-of-week breakdowns are bucketed in.
# Set this to your SOC's timezone or "busiest hour" is meaningless
STATS_TIMEZONE=America/New_York
STATS_TOP_N=10
# Minimum alerts before a rule can be called noisy
STATS_NOISE_MIN_ALERTS=10
# Field holding the program name - change if your alerts map it elsewhere
STATS_PROCESS_FIELD=process.name
