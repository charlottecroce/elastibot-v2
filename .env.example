# ------------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is gitignored and must
# NEVER be committed. This is the only file that holds secrets.
# ------------------------------------------------------------------

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SOCKET_MODE=true # false = run HTTP server on PORT
PORT=3000

# --- Elastic ---
KIBANA_URL=https://kibana.internal:5601
ELASTICSEARCH_URL=https://es.internal:9200
# Service account API key (encoded form) used by the watchers and for space lookups
ELASTIC_SERVICE_API_KEY=base64EncodedApiKey=
# Set to false for self-signed certs on an internal cluster
ELASTIC_TLS_REJECT_UNAUTHORIZED=true
ELASTIC_TIMEOUT_MS=15000
ALERTS_INDEX=.alerts-security.alerts-*
DEFAULT_CASE_OWNER=securitySolution

# --- Elastibot secrets ---
# 32+ chars. Used to encrypt analysts' stored API keys at rest
ELASTIBOT_SECRET_KEY=change-me-to-a-long-random-string

# --- Watchers ---
WATCHERS_ENABLED=true
WATCH_POLL_MS=60000
DEFAULT_CHANNEL=C0123456789
WATCH_CASE_SPACES=default
