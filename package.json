{
  "name": "elastibot",
  "version": "1.0.0",
  "description": "Slack bot that helps analysts create Elastic (Kibana) cases from alerts and sends new alerts/cases into Slack channels.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "check": "npm run lint && npm run check:syntax",
    "check:syntax": "node -e \"const{execFileSync}=require('child_process'),fs=require('fs'),p=require('path');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.name==='node_modules'||e.name.startsWith('.')?[]:e.isDirectory()?walk(p.join(d,e.name)):e.name.endsWith('.js')?[p.join(d,e.name)]:[]);const f=walk('.');f.forEach(x=>execFileSync(process.execPath,['--check',x]));console.log('syntax ok: '+f.length+' files')\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@slack/bolt": "^3.22.0",
    "axios": "^1.19.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  }
}