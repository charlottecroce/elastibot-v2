{
  "name": "elastibot",
  "version": "1.0.0",
  "description": "Slack bot that helps analysts create Elastic (Kibana) cases from alerts and sends new alerts/cases into Slack channels.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "check": "npm run lint && npm run check:syntax",
    "check:syntax": "node scripts/check-syntax.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@slack/bolt": "^3.22.0",
    "axios": "^1.19.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  }
}